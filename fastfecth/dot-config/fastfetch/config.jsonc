// Generated by Fastfetch Studio — https://github.com/fastfetch-cli/fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " ",
    "key": {
      "type": "both-1",
      "width": 11
    },
    "size": {
      "ndigits": 1
    }
  },
  "logo": {
    "type": "iterm",
    //"source": "/Users/leo/Library/Mobile Documents/com~apple~CloudDocs/Dotfiles/fastfetch/logos/*.png",
    "height": 15,
    "width": 22,
    "preserveAspectRatio": true,
    "printRemaining": false,
    "padding": {
      "right": 2
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "–",
      "times": 10,
      "outputColor": "yellow"
    },
    "os",
    "host",
    "kernel",
    "shell",
    {
      "type": "terminal",
      "key": "Term"
    },
    "cpu",
    "gpu",
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "uptime",
      "format": "{days} days, {hours} hours"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} {percentage}"
    },
    {
      "type": "disk",
      "key": "Disk", // "{name~0,9}",
      "format": "{#magenta}{mountpoint}{#} {size-used} / {size-total} {size-percentage}"
    },
    {
      "type": "datetime",
      "key": "Now",
      "format": "{#blue}{hour}:{minute}{#} {weekday-short} {day-in-month} {month-name-short} {year}"
    }
  ]
}